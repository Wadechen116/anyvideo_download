<Window x:Class="AnyVideoDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="740" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft JhengHei UI" FontSize="13.333"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="6,6,6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="64" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 網址 -->
        <GroupBox Grid.Row="0" Header="網址（每行一個，可一次貼多個）">
            <StackPanel>
                <TextBox x:Name="UrlBox" Height="96" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="網址">
                    <!-- 內建選單的文字跟著 .NET 語系，自己做一份中文的 -->
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="貼上" Command="ApplicationCommands.Paste" />
                            <MenuItem Header="剪下" Command="ApplicationCommands.Cut" />
                            <MenuItem Header="複製" Command="ApplicationCommands.Copy" />
                            <Separator />
                            <MenuItem Header="全選" Command="ApplicationCommands.SelectAll" />
                            <MenuItem Header="清除" Click="ClearUrls_Click" />
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="貼上" Click="PasteUrls_Click" />
                    <Button Content="清除" Click="ClearUrls_Click" />
                    <Button x:Name="BtnProbe" Content="解析第一個網址" Click="Probe_Click" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 輸出設定 -->
        <GroupBox Grid.Row="1" Header="輸出設定" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                    <TextBlock Text="下載類型：" Style="{StaticResource FieldLabel}" />
                    <RadioButton x:Name="RbVideo" Content="影片" GroupName="Mode" Margin="0,0,12,0"
                                 VerticalContentAlignment="Center" Checked="Option_Changed" />
                    <RadioButton x:Name="RbAudio" Content="僅音訊" GroupName="Mode"
                                 VerticalContentAlignment="Center" Checked="Option_Changed" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="影片格式" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="CbContainer" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="影片格式"
                          SelectionChanged="Option_Changed" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="畫質" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="CbQuality" Grid.Row="1" Grid.Column="3" AutomationProperties.Name="畫質" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="取捨" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="CbPriority" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                          HorizontalAlignment="Left" MinWidth="300" AutomationProperties.Name="取捨"
                          SelectionChanged="Option_Changed" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="音訊格式" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="CbAudioFormat" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="音訊格式"
                          SelectionChanged="Option_Changed" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="位元率 (kbps)" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="CbBitrate" Grid.Row="3" Grid.Column="3" AutomationProperties.Name="位元率" />

                <WrapPanel Grid.Row="4" Grid.ColumnSpan="5" Margin="0,6,0,2">
                    <CheckBox x:Name="ChkPlaylist" Content="下載整個播放清單" />
                    <CheckBox x:Name="ChkMeta" Content="寫入標題等資訊" />
                    <CheckBox x:Name="ChkThumb" Content="嵌入封面縮圖" />
                    <CheckBox x:Name="ChkSubs" Content="嵌入字幕（中文／英文）" />
                </WrapPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="登入狀態" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="CbBrowser" Grid.Row="5" Grid.Column="1" AutomationProperties.Name="登入狀態" />
                <TextBlock Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Hint}"
                           Text="需要登入才能看的內容，借用瀏覽器已登入的 cookies" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="cookies.txt" Style="{StaticResource FieldLabel}" />
                <DockPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,4,0,0">
                    <Button x:Name="BtnCookiesClear" DockPanel.Dock="Right" Content="清除" Margin="0" Click="ClearCookies_Click" />
                    <Button x:Name="BtnCookiesAuto" DockPanel.Dock="Right" Content="自動偵測" Margin="6,0,0,0" Click="AutoCookies_Click"
                            AutomationProperties.Name="自動偵測 cookies.txt"
                            ToolTip="在「下載」「桌面」「文件」等資料夾找匯出的 cookies.txt" />
                    <Button x:Name="BtnCookiesPick" DockPanel.Dock="Right" Content="選擇…" Margin="6,0" Click="ChooseCookies_Click" />
                    <TextBox x:Name="CookiesBox" IsReadOnly="True" VerticalContentAlignment="Center"
                             AutomationProperties.Name="cookies.txt"
                             ToolTip="匯出的 cookies.txt（Netscape 格式）；指定後優先使用，不再讀瀏覽器" />
                </DockPanel>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="儲存位置" Style="{StaticResource FieldLabel}" />
                <DockPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="開啟資料夾" Margin="0" Click="OpenDir_Click" />
                    <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Content="瀏覽…" Margin="6,0" Click="ChooseDir_Click" />
                    <TextBox x:Name="OutDirBox" VerticalContentAlignment="Center" AutomationProperties.Name="儲存位置" />
                </DockPanel>
            </Grid>
        </GroupBox>

        <!-- 動作 -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="BtnUpdate" DockPanel.Dock="Right" Content="更新下載核心" Margin="0" Click="UpdateCore_Click" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnStart" Content="開始下載" FontWeight="Bold" Click="Start_Click" />
                <Button x:Name="BtnCancel" Content="取消" IsEnabled="False" Click="Cancel_Click" />
                <Button x:Name="BtnCapture" Content="從瀏覽器擷取…" Click="Capture_Click"
                        ToolTip="網站解析不了、但瀏覽器能播時：開瀏覽器播放，程式抓出實際的影音網址來下載" />
            </StackPanel>
        </DockPanel>

        <!-- 進度 -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="LblItem" Text="待機" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="Bar" Height="16" Minimum="0" Maximum="100" Margin="0,4,0,2" />
            <TextBlock x:Name="LblStatus" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 紀錄 -->
        <GroupBox Grid.Row="4" Header="紀錄" Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,4,0,0" Content="清除紀錄"
                        Click="ClearLog_Click" />
                <RichTextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="紀錄">
                    <FlowDocument PagePadding="2" />
                </RichTextBox>
            </DockPanel>
        </GroupBox>

        <!-- 狀態列 -->
        <TextBlock x:Name="LblEnv" Grid.Row="5" Margin="0,6,0,0" Style="{StaticResource Hint}" />
    </Grid>
</Window>
