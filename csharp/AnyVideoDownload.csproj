<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>AnyVideoDownload</AssemblyName>
    <RootNamespace>AnyVideoDownload</RootNamespace>
    <StartupObject>AnyVideoDownload.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>AnyVideo Download</Product>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- EnsureH264 外掛（與 Qt 版共用）複製到執行檔旁邊的 yt-dlp-plugins -->
    <None Include="..\shared\yt-dlp-plugins\**\*.py" LinkBase="yt-dlp-plugins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
